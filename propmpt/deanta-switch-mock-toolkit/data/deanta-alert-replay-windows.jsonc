{
  // Replay plan: fetch raw data for the SOURCE imei in each window, replay it onto the MOCK imei.
  // All times are UTC. Epoch values are milliseconds. duration_hours = (end - start) in hours.
  // Every window is exactly 24 hours (the agreed maximum).
  // Alert types and counts come from the source vehicles' alert logs for 2026-09-01 .. 2026-10-01.
  // No single day on any vehicle contains every alert type; the richest one-day window in the
  // fleet has 10 types. So: 4 windows on one vehicle cover 14 types, 4 add-on windows on other
  // vehicles cover the remaining 4. Together the 8 windows cover all 18 types seen in the fleet.

  "source_account": { "id": "1482046680973967360", "name": "Deanta" },
  "mock_account": { "id": "1606685851746566144", "name": "intangles-switch-test-deanta" },
  "api": "https://apis.intangles-aws-eu-north-1.eu.intangles.com",
  "max_window_hours": 24,

  // Main set: one vehicle, four windows, 14 of the 18 alert types.
  "main": {
    "source": { "imei": "866308064390602", "plate": "AY74ULE", "vehicle_id": "1535690443373674496" },
    "mock": { "imei": "866308060277944", "plate": "MK74ULE", "vehicle_id": "1606688593688920064" },
    "windows": [
      {
        // Needed for the only DTC this vehicle raised (11 Sep 05:29 UTC).
        "id": "main-1",
        "start": "2026-09-11T00:00:00Z",
        "end": "2026-09-12T00:00:00Z",
        "start_ms": 1789084800000,
        "end_ms": 1789171200000,
        "duration_hours": 24,
        "new_types": ["dtc"],
        "alerts": { "dtc": 1, "stoppage": 12, "speeding": 6, "geofence": 6, "idling": 1, "idling_start": 1, "fuel_bhara": 1 }
      },
      {
        // The driving-behaviour day: harsh acceleration, hard braking, idling, and the DEF fill.
        "id": "main-2",
        "start": "2026-09-14T12:25:00Z",
        "end": "2026-09-15T12:25:00Z",
        "start_ms": 1789388700000,
        "end_ms": 1789475100000,
        "duration_hours": 24,
        "new_types": ["over_acc", "hard_brake", "def_bhara", "stoppage", "speeding", "geofence", "idling", "idling_start", "fuel_bhara"],
        "alerts": { "stoppage": 10, "speeding": 3, "geofence": 4, "idling_start": 3, "idling": 1, "over_acc": 2, "hard_brake": 3, "fuel_bhara": 1, "def_bhara": 1 }
      },
      {
        // continuous_driving fires at 07:53 on 23 Sep, so its 4-hour lead-in is inside this window.
        // algo_output fires at 12:16 on 22 Sep.
        "id": "main-3",
        "start": "2026-09-22T08:00:00Z",
        "end": "2026-09-23T08:00:00Z",
        "start_ms": 1790064000000,
        "end_ms": 1790150400000,
        "duration_hours": 24,
        "new_types": ["algo_output", "continuous_driving"],
        "alerts": { "stoppage": 8, "speeding": 7, "geofence": 26, "over_acc": 2, "algo_output": 1, "continuous_driving": 1 }
      },
      {
        // The only fuel_low_level (04:52) and device_firmware_mismatch (21:04) this vehicle raised.
        "id": "main-4",
        "start": "2026-09-24T00:00:00Z",
        "end": "2026-09-25T00:00:00Z",
        "start_ms": 1790208000000,
        "end_ms": 1790294400000,
        "duration_hours": 24,
        "new_types": ["fuel_low_level", "device_firmware_mismatch"],
        "alerts": { "stoppage": 3, "speeding": 3, "geofence": 16, "idling_start": 1, "fuel_bhara": 1, "fuel_low_level": 1, "device_firmware_mismatch": 1 }
      }
    ]
  },

  // Add-on set: the four types AY74ULE never raised. Each fired on a different vehicle,
  // so each window has its own source/mock IMEI pair.
  "addons": [
    {
      // device_offline_log fired at 2026-09-08 01:37:06 UTC.
      "id": "addon-device_offline_log",
      "target_type": "device_offline_log",
      "source": { "imei": "866308064409774", "plate": "AY25TXF", "vehicle_id": "1500891326235803648" },
      "mock": { "imei": "866308069713956", "plate": "MK25TXF", "vehicle_id": "1606688646134497280" },
      "start": "2026-09-07T05:00:00Z",
      "end": "2026-09-08T05:00:00Z",
      "start_ms": 1788757200000,
      "end_ms": 1788843600000,
      "duration_hours": 24,
      "alerts": { "device_offline_log": 1, "geofence": 8, "stoppage": 9, "speeding": 28, "over_acc": 2, "fuel_bhara": 1, "fuel_low_level": 1 }
    },
    {
      // data_loss fired at 2026-09-09 13:54:46 UTC. It appeared once in the whole fleet.
      "id": "addon-data_loss",
      "target_type": "data_loss",
      "source": { "imei": "869305070951051", "plate": "AY26PNE" },
      "mock": { "imei": "869305074633291", "plate": "MK26PNE", "vehicle_id": "1606688821326381056" },
      "start": "2026-09-08T17:00:00Z",
      "end": "2026-09-09T17:00:00Z",
      "start_ms": 1788886800000,
      "end_ms": 1788973200000,
      "duration_hours": 24,
      "alerts": { "data_loss": 1, "stoppage": 14, "speeding": 9 }
    },
    {
      // device_obd_data_missing fired at 2026-09-24 10:21:53 UTC.
      "id": "addon-device_obd_data_missing",
      "target_type": "device_obd_data_missing",
      "source": { "imei": "866308064407851", "plate": "AY26PNU" },
      "mock": { "imei": "866308067533331", "plate": "MK26PNU", "vehicle_id": "1606688680083193856" },
      "start": "2026-09-23T14:00:00Z",
      "end": "2026-09-24T14:00:00Z",
      "start_ms": 1790172000000,
      "end_ms": 1790258400000,
      "duration_hours": 24,
      "alerts": { "device_obd_data_missing": 1, "device_firmware_mismatch": 1, "stoppage": 18, "geofence": 6, "speeding": 1, "idling": 1, "idling_start": 1, "continuous_driving": 1 }
    },
    {
      // def_chori fired at 2026-09-26 22:04:13 UTC. It appeared once in the whole fleet.
      "id": "addon-def_chori",
      "target_type": "def_chori",
      "source": { "imei": "866308064410152", "plate": "BF72VNX" },
      "mock": { "imei": "866308068278555", "plate": "MK72VNX", "vehicle_id": "1606688669215752192" },
      "start": "2026-09-26T02:00:00Z",
      "end": "2026-09-27T02:00:00Z",
      "start_ms": 1790388000000,
      "end_ms": 1790474400000,
      "duration_hours": 24,
      "alerts": { "def_chori": 1, "geofence": 52 }
    }
  ],

  // Coverage summary.
  "coverage": {
    "main_only": ["dtc", "stoppage", "speeding", "geofence", "idling", "idling_start", "fuel_bhara", "over_acc", "hard_brake", "def_bhara", "algo_output", "continuous_driving", "fuel_low_level", "device_firmware_mismatch"],
    "added_by_addons": ["device_offline_log", "data_loss", "device_obd_data_missing", "def_chori"],
    "total_types": 18,
    "total_windows": 8,
    "total_hours": 192
  },

  // Alerts that may not reproduce from replayed data alone.
  "caveats": [
    "Each window starts with no prior trip state, so alerts that depend on earlier data (continuous_driving, idling, stoppage) can differ at the start of a window.",
    "device_offline_log, data_loss, device_obd_data_missing and device_firmware_mismatch come from gaps or device state rather than telemetry values, so they may behave differently under replay.",
    "fuel_bhara, def_bhara and def_chori compare levels across time; a window that starts mid-change may miss them.",
    "algo_output depends on algorithm state and may not fire on the mock."
  ]
}
